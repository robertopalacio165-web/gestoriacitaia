# ============================================================
# GestoriaCitaIA — Variables de entorno / Environment Variables
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# Copy this file as .env and fill in the real values.
# ============================================================

# ── FRONTEND (Vite) ─────────────────────────────────────────
# En Replit estas variables las pone el sistema.
# En Vercel/producción, BASE_PATH = "/" y PORT lo maneja Vercel.
BASE_PATH=/
PORT=5173

# ── STRIPE (pagos) ───────────────────────────────────────────
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Precios de los planes en Stripe (crear en el dashboard de Stripe)
STRIPE_PRICE_CITA=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_REG=price_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STD=price_xxxxxxxxxxxxxxxxxxxx

# ── GMAIL / EMAIL ────────────────────────────────────────────
# Habilita "Contraseñas de aplicación" en tu cuenta Google:
# https://myaccount.google.com/apppasswords
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ── WHATSAPP (Meta Cloud API) ────────────────────────────────
# Crea una app en: https://developers.facebook.com/
META_WA_PHONE_ID=xxxxxxxxxxxxxxxxxxxx
META_WA_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxx
META_WA_TEMPLATE_CITA=confirmacion_cita
META_WA_TEMPLATE_DOCS=docs_pendientes

# ── IA / LLM ────────────────────────────────────────────────
# Para los agentes Mohamed, Sara y Khalid
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# o usa: ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── BASE DE DATOS ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/gestoriacitaia

# ── AUTENTICACIÓN ────────────────────────────────────────────
# Si usas Replit Auth / Clerk / Auth0
SESSION_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio

# ── ENTORNO ─────────────────────────────────────────────────
NODE_ENV=production
